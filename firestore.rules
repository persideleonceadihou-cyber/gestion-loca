rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create, read, update: if isOwner(userId);
      allow delete: if false;

      match /tenants/{tenantId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /locataires/{locataireId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /biens/{bienId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /paiements/{paiementId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    // Codes de paiement — collection racine
    // Lecture publique pour lookup par code, écriture réservée aux admins authentifiés
    match /payment_codes/{code} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
