rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create, read, update: if isOwner(userId);
      allow delete: if false;

      match /tenants/{tenantId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /locataires/{tenantId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
        allow update: if isOwner(userId)
                      || (request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['lastPaymentDate', 'lastPaymentAmount', 'confirmationCode'])
                          && request.resource.data.confirmationCode == resource.data.paymentCode
                          && request.resource.data.lastPaymentAmount is number
                          && request.resource.data.lastPaymentAmount > 0);
      }

      match /biens/{bienId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /paiements/{paiementId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId)
                      || (request.resource.data.keys().hasAll(['amount', 'date', 'tenantId', 'confirmationCode'])
                          && request.resource.data.amount is number
                          && request.resource.data.amount > 0
                          && get(/databases/$(database)/documents/users/$(userId)/locataires/$(request.resource.data.tenantId))
                               .data.paymentCode == request.resource.data.confirmationCode);
      }
    }

    match /payment_codes/{code} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}